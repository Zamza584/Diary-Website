@using static Microsoft.AspNetCore.Components.Web.RenderMode

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["NoteKeeping.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
            window.animateJournalPageButton = (element) => {
                if (!element || !element.animate) return;
                element.animate(
                    [{ transform: 'scale(1)' }, { transform: 'scale(1.20)' }, { transform: 'scale(1)' }],
                    { duration: 280, easing: 'ease-out' }
                );
            };

            window.animateMoreButton = (element) => {
                if (!element || !element.animate) return;
                element.animate(
                    [{ transform: 'scale(.94)' }, { transform: 'scale(1)' }],
                    { duration: 280, easing: 'ease-out' }
                );
            };

            window.animateMoreMenu = (element) => {
                if (!element || !element.animate) return;
                element.animate(
                    [{ opacity: 0, transform: 'translateX(14px) scale(.97)' },
                     { opacity: 1, transform: 'translateX(0) scale(1)' }],
                    { duration: 220, easing: 'ease-out' }
                );
            };

            window.getContentEditableHtml = (element) => {
                if (!element) return '';

                const title = element.firstElementChild;
                if (element.childElementCount === 1 &&
                    title.classList.contains('journal-title-aurora') &&
                    title.textContent === 'Journal') {
                    return 'Journal';
                }

                return element.innerHTML;
            };

            window.setContentEditableHtml = (element, html, isFirstPage) => {
                if (!element) return;

                const content = html || '';
                if (isFirstPage && content === 'Journal') {
                    element.innerHTML = '<span class="journal-title-aurora">Journal</span>';
                    return;
                }

                element.innerHTML = content;
            };

            window.preventUnsafeEditorPaste = (element) => {
                if (!element || element.dataset.safePasteAttached === 'true') return;
                element.dataset.safePasteAttached = 'true';
                element.addEventListener('paste', (event) => {
                    event.preventDefault();
                    const selection = window.getSelection();
                    if (!selection || selection.rangeCount === 0) return;

                    const range = selection.getRangeAt(0);
                    if (!element.contains(range.commonAncestorContainer)) return;

                    const fragment = document.createDocumentFragment();
                    const html = event.clipboardData?.getData('text/html') ?? '';
                    if (html) {
                        const template = document.createElement('template');
                        template.innerHTML = html;
                        const allowedTags = new Set(['b', 'br', 'div', 'em', 'h2', 'i', 'p', 'span', 'strong', 'u']);
                        const sanitizeNode = (node) => {
                            if (node.nodeType === Node.TEXT_NODE) {
                                return document.createTextNode(node.nodeValue ?? '');
                            }
                            const children = Array.from(node.childNodes, sanitizeNode);
                            if (node.nodeType !== Node.ELEMENT_NODE) {
                                const unwrapped = document.createDocumentFragment();
                                children.forEach(child => unwrapped.append(child));
                                return unwrapped;
                            }
                            const tag = node.tagName.toLowerCase();
                            if (!allowedTags.has(tag)) {
                                const unwrapped = document.createDocumentFragment();
                                children.forEach(child => unwrapped.append(child));
                                return unwrapped;
                            }
                            const safeElement = document.createElement(tag);
                            children.forEach(child => safeElement.append(child));
                            return safeElement;
                        };
                        Array.from(template.content.childNodes, sanitizeNode)
                            .forEach(child => fragment.append(child));
                    } else {
                        const text = event.clipboardData?.getData('text/plain') ?? '';
                        text.split(/\r\n?|\n/).forEach((line, index) => {
                            if (index > 0) fragment.append(document.createElement('br'));
                            fragment.append(document.createTextNode(line));
                        });
                    }

                    range.deleteContents();
                    const lastNode = fragment.lastChild;
                    range.insertNode(fragment);
                    if (lastNode) {
                        range.setStartAfter(lastNode);
                        range.collapse(true);
                        selection.removeAllRanges();
                        selection.addRange(range);
                    }
                    element.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertFromPaste' }));
                });
                element.addEventListener('drop', (event) => event.preventDefault());
            };

            window.formatContentEditableSelection = (element, format) => {
                if (!element) return null;

                const selection = window.getSelection();
                if (!selection || selection.rangeCount === 0 || selection.isCollapsed) return null;

                const range = selection.getRangeAt(0);
                if (!element.contains(range.commonAncestorContainer)) return null;

                const commands = {
                    italic: 'italic',
                    bold: 'bold',
                    underline: 'underline',
                    title: 'formatBlock'
                };
                const command = commands[format];
                if (!command) return null;

                element.focus();
                document.execCommand(command, false, format === 'title' ? 'h2' : undefined);
                return element.innerHTML;
            };
    </script>
</body>

</html>
