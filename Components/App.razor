@using static Microsoft.AspNetCore.Components.Web.RenderMode

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["NoteKeeping.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
            window.animateJournalPageButton = (element) => {
                if (!element || !window.gsap) return;
                window.gsap.fromTo(element, { scale: 1 }, {
                    scale: 1.20,
                    duration: 0.14,
                    repeat: 1,
                    yoyo: true,
                    ease: 'power1.out',
                    clearProps: 'transform'
                });
            };

            window.getContentEditableHtml = (element) => {
                if (!element) return '';

                const title = element.firstElementChild;
                if (element.childElementCount === 1 &&
                    title.classList.contains('journal-title-aurora') &&
                    title.textContent === 'Journal') {
                    return 'Journal';
                }

                return element.innerHTML;
            };

            window.setContentEditableHtml = (element, html, isFirstPage) => {
                if (!element) return;

                const content = html || '';
                if (isFirstPage && content === 'Journal') {
                    element.innerHTML = '<span class="journal-title-aurora">Journal</span>';

                    const title = element.firstElementChild;
                    if (window.gsap) {
                        window.gsap.killTweensOf(title);
                        window.gsap.fromTo(title, { backgroundPosition: '0% 50%' }, {
                            backgroundPosition: '100% 50%',
                            duration: 5,
                            repeat: -1,
                            yoyo: true,
                            ease: 'none'
                        });
                    }
                    return;
                }

                element.innerHTML = content;
            };

            window.formatContentEditableSelection = (element, format) => {
                if (!element) return null;

                const selection = window.getSelection();
                if (!selection || selection.rangeCount === 0 || selection.isCollapsed) return null;

                const range = selection.getRangeAt(0);
                if (!element.contains(range.commonAncestorContainer)) return null;

                const commands = {
                    italic: 'italic',
                    bold: 'bold',
                    underline: 'underline',
                    title: 'formatBlock'
                };
                const command = commands[format];
                if (!command) return null;

                element.focus();
                document.execCommand(command, false, format === 'title' ? 'h2' : undefined);
                return element.innerHTML;
            };
    </script>
</body>

</html>
