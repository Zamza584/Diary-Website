@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page @(IsJournalPage ? "journal-home" : string.Empty)">
    <div>
@* logo *@
    </div>
    <main>
        <article class="content">
            @Body
        </article>
        <footer class="site-footer">
            <span>&copy; @DateTime.UtcNow.Year Comfidiario</span>
            <nav aria-label="Legal and support">
                <a href="/privacy">Privacy Policy</a>
                <a href="/terms">Terms of Service</a>
                <a href="/cookies">Cookie Policy</a>
                <a href="/contact">Contact &amp; Support</a>
            </nav>
        </footer>
    </main>
    <div class="sidebar">
        <NavMenu />
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool IsJournalPage
    {
        get
        {
            var routePath = Navigation.ToBaseRelativePath(Navigation.Uri);
            var queryIndex = routePath.IndexOf('?');
            if (queryIndex >= 0)
            {
                routePath = routePath[..queryIndex];
            }

            routePath = routePath.Trim('/');
            return string.IsNullOrEmpty(routePath) ||
                (routePath.StartsWith("journals/", StringComparison.OrdinalIgnoreCase) &&
                 int.TryParse(routePath["journals/".Length..], out _));
        }
    }
}