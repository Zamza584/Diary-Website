@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="navigation @(isMenuOpen ? "open" : "")">
    <button class="navbar-toggler" type="button" aria-label="Toggle navigation" aria-expanded="@isMenuOpen"
            @onclick="ToggleMenu">
        <span></span>
        <span></span>
        <span></span>
    </button>
    <div class="navigation-links">
        <nav class="nav flex-column" aria-label="Main navigation">
            <div class="nav-item px-3">
                <AuthorizeView>
                    <Authorized>
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                            Home
                        </NavLink>
                        <NavLink class="nav-link" href="/journals" @onclick="CloseMenu">
                            Journals
                        </NavLink>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                            Home
                        </NavLink>
                        <NavLink class="nav-link" href="/login" Match="NavLinkMatch.All" @onclick="CloseMenu">
                            Login
                        </NavLink>
                        <NavLink class="nav-link" href="/register" Match="NavLinkMatch.All" @onclick="CloseMenu">
                            Register
                        </NavLink>
                        <NavLink class="nav-link" href="/journals" Match="NavLinkMatch.All" @onclick="CloseMenu">
                            Journals
                        </NavLink>
                    </NotAuthorized>
                </AuthorizeView>

                <div class="nav-more-wrapper">
                    <button class="nav-link nav-more-button" type="button" aria-expanded="@isMoreMenuOpen"
                            aria-controls="nav-more-menu" @ref="moreButtonRef" @onclick="ToggleMoreMenu">
                        More
                    </button>
                    @if (isMoreMenuOpen)
                    {
                        <div class="nav-more-menu" id="nav-more-menu" @ref="moreMenuRef">
                            <NavLink class="nav-link" href="/about" @onclick="CloseMenu">About</NavLink>
                            <NavLink class="nav-link" href="/contact" @onclick="CloseMenu">Contact</NavLink>
                            <NavLink class="nav-link" href="/donate" @onclick="CloseMenu">Donate</NavLink>
                            <NavLink class="nav-link" href="/privacy" @onclick="CloseMenu">Legal &amp; Privacy</NavLink>
                            <AuthorizeView>
                                <Authorized>
                                    <NavLink class="nav-link" href="/account/delete" @onclick="CloseMenu">
                                        Delete account
                                    </NavLink>
                                    <form method="post" action="/logout" class="nav-logout-form">
                                        <AntiforgeryToken />
                                        <button type="submit" class="nav-link nav-logout-button">
                                            Logout
                                        </button>
                                    </form>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    }
                </div>

                <NavLink class="nav-link nav-profile-link" href="/profile" Match="NavLinkMatch.All"
                         @onclick="CloseMenu">
                    Profile
                </NavLink>
            </div>
        </nav>
    </div>
</div>

@code {
    private bool isMenuOpen;
    private bool isMoreMenuOpen;
    private bool animateMoreAfterRender;
    private ElementReference moreButtonRef;
    private ElementReference moreMenuRef;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
        if (!isMenuOpen)
        {
            isMoreMenuOpen = false;
        }
    }

    private void ToggleMoreMenu()
    {
        isMoreMenuOpen = !isMoreMenuOpen;
        animateMoreAfterRender = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!animateMoreAfterRender)
        {
            return;
        }

        animateMoreAfterRender = false;
        await JS.InvokeVoidAsync("animateMoreButton", moreButtonRef);
        if (isMoreMenuOpen)
        {
            await JS.InvokeVoidAsync("animateMoreMenu", moreMenuRef);
        }
    }

    private void CloseMenu()
    {
        isMenuOpen = false;
        isMoreMenuOpen = false;
    }
}
