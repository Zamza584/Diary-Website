@page "/contact"
@page "/contact-support"

<PageTitle>Contact &amp; Support | Comfidiario</PageTitle>
<SeoMetadata Title="Contact &amp; Support | Comfidiario"
             Description="Find help and contact information for Comfidiario."
             CanonicalPath="/contact"
             Robots="index, follow" />

<main class="legal-page">
    <article class="legal-document">
        <p class="legal-eyebrow">We're here to help</p>
        <h1>Contact &amp; Support</h1>
        <p>
            For help with your account, a privacy question, or feedback about Comfidiario, contact:
        </p>
        <p class="contact-email-placeholder">
            <strong>Email:</strong> <span>[Add support email address]</span>
        </p>
        <p class="legal-note">
            This is a placeholder, not a working address. Replace it with a monitored support email before
            publishing the service.
        </p>
        <p>
            Please do not include your password or sensitive journal entries in a support request. If you
            need to remove your account and its journals, use the
            <a href="/account/delete">account deletion page</a> while signed in.
        </p>

        <nav class="legal-page-links" aria-label="Other legal pages">
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
            <a href="/cookies">Cookie Policy</a>
        </nav>
    </article>
</main>
