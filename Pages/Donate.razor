@page "/donate"

<PageTitle>Support Comfidiario</PageTitle>
<SeoMetadata Title="Support Comfidiario"
             Description="Learn how to support Comfidiario, a calm, private place to write."
             CanonicalPath="/donate" />

<main class="donate-page">
    <section class="donate-card" aria-labelledby="donate-title">
        <p class="donate-eyebrow">A note of thanks</p>
        <h1 id="donate-title">Support Comfidiario</h1>
        <p class="donate-intro">
            Thank you for making room for Comfidiario in your day. This quiet journal is here to give your thoughts
            a softer place to land.
        </p>

        <div class="donate-notice" role="status">
            <h2>Donations aren't available yet</h2>
            <p>
                Online contributions aren't set up right now. For now, using Comfidiario, sharing it with someone,
                or sending feedback is a wonderful way to support the project.
            </p>
        </div>

        <div class="donate-actions">
            <a class="donate-button primary" href="/">Return to your diary</a>
            <a class="donate-button secondary" href="/about">About Comfidiario</a>
        </div>
    </section>
</main>
