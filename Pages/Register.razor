@page "/register"
@using System.Net.Mail
@using Microsoft.EntityFrameworkCore
@using NoteKeeping.Data
@using NoteKeeping.Models
@inject NoteKeepingDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>Create an account | NoteKeeping</PageTitle>
<SeoMetadata Title="Create an account | NoteKeeping"
             Description="Create your NoteKeeping account and start a private online diary for your thoughts and memories."
             CanonicalPath="/register" />

<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-card">
            <div class="auth-header">
                <span class="auth-kicker">Start writing</span>
                <h1>Create account</h1>
                <p>Set up your journal and keep your thoughts organized.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="auth-alert auth-alert-error" aria-live="polite">@ErrorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="auth-alert auth-alert-success" aria-live="polite">@SuccessMessage</div>
            }

            <div class="auth-form">
                <div class="auth-field">
                    <label for="name">Name</label>
                    <input class="auth-input" type="text" name="name" id="name" @bind="Name"
                           placeholder="Your display name">
                </div>

                <div class="auth-field">
                    <label for="email">Email</label>
                    <input class="auth-input" type="email" name="email" id="email" @bind="Email"
                           placeholder="you@example.com">
                </div>

                <div class="auth-field">
                    <label for="password">Password</label>
                    <div class="auth-password-control">
                        <input class="auth-input" type="@(showPassword ? "text" : "password")" name="password"
                               id="password" @bind="Password" autocomplete="new-password"
                               placeholder="Create a password">
                        <button class="auth-password-toggle" type="button" aria-pressed="@showPassword"
                                aria-label="@(showPassword ? "Hide password" : "Show password")"
                                @onclick="() => showPassword = !showPassword">
                            @(showPassword ? "Hide" : "Show")
                        </button>
                    </div>
                </div>

                <div class="auth-field">
                    <label for="confirm-password">Confirm password</label>
                    <div class="auth-password-control">
                        <input class="auth-input" type="@(showConfirmPassword ? "text" : "password")"
                               name="confirmPassword" id="confirm-password" @bind="ConfirmPassword"
                               autocomplete="new-password" placeholder="Re-enter your password">
                        <button class="auth-password-toggle" type="button" aria-pressed="@showConfirmPassword"
                                aria-label="@(showConfirmPassword ? "Hide confirmation password" : "Show confirmation password")"
                                @onclick="() => showConfirmPassword = !showConfirmPassword">
                            @(showConfirmPassword ? "Hide" : "Show")
                        </button>
                    </div>
                </div>

                <div class="auth-actions">
                    <button class="auth-button auth-button-primary" type="button" @onclick="RegisterAsync">Create
                        account</button>
                        <a class="auth-button auth-button-secondary" href="/login">Back to login</a>
                    </div>
                </div>
                <p class="auth-legal-links">
                    By creating an account, you acknowledge the <a href="/privacy">Privacy Policy</a> and
                    <a href="/terms">Terms of Service</a>.
                </p>
            </div>
        </div>
    </div>

@code {
    private string Name { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;
    private bool showPassword;
    private bool showConfirmPassword;

    private async Task RegisterAsync()
    {
        SuccessMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(Name) || string.IsNullOrWhiteSpace(Email) ||
            string.IsNullOrWhiteSpace(Password) || string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            ErrorMessage = "Please complete all fields.";
            return;
        }

        var normalizedName = Name.Trim();
        var normalizedEmail = Email.Trim();

        try
        {
            var mailAddress = new MailAddress(normalizedEmail);
            if (mailAddress.Address != normalizedEmail)
            {
                ErrorMessage = "Please enter a valid email address.";
                return;
            }
        }
        catch
        {
            ErrorMessage = "Please enter a valid email address.";
            return;
        }

        if (Password.Length < 12)
        {
            ErrorMessage = "Password must be at least 12 characters long.";
            return;
        }

        if (!string.Equals(Password, ConfirmPassword, StringComparison.Ordinal))
        {
            ErrorMessage = "Passwords do not match.";
            return;
        }

        var lowerEmail = normalizedEmail.ToLower();
        var exists = await DbContext.UserAccounts.AnyAsync(u => u.Email.ToLower() == lowerEmail);

        if (exists)
        {
            ErrorMessage = "That email is already registered.";
            return;
        }

        var user = new UserAccount
        {
            Name = normalizedName,
            Email = lowerEmail,
            PasswordHash = BCrypt.Net.BCrypt.HashPassword(Password),
            CreatedAt = DateTime.UtcNow
        };

        DbContext.UserAccounts.Add(user);
        await DbContext.SaveChangesAsync();

        SuccessMessage = "Account created successfully.";
        ErrorMessage = string.Empty;

        Name = string.Empty;
        Email = string.Empty;
        Password = string.Empty;
        ConfirmPassword = string.Empty;
        showPassword = false;
        showConfirmPassword = false;

        await Task.Delay(500);
        Navigation.NavigateTo("/login");
    }
}
