@page "/"
@page "/journals/{JournalId:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using NoteKeeping.Data
@using NoteKeeping.Models
@using NoteKeeping.Services
@using System.Security.Claims
@using System.Globalization


<PageTitle>@(JournalId.HasValue ? notebook?.Title ?? "Journal unavailable" : "Notes")</PageTitle>

@inject ThemeService ThemeService
@inject NoteKeepingDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotebookStorageService StorageService
@inject NavigationManager NavManager

@inject IJSRuntime JS

@if (JournalId.HasValue && notebook is null)
{
    <div class="journal-not-found">
        <h1>Journal unavailable</h1>
        <p>This journal could not be found or is not available to your account.</p>
        <button class="journal-action primary" type="button" @onclick="NavigateToJournals">Journals</button>
    </div>
}
else
{
    <div class="theme-@Theme"
         style="background-color: @ThemeService.BgColor; color: @ThemeService.TextColor; font-family: 'Georgia', serif; transition: background-color 0.5s, color 0.5s;">
        <div class="journal-page-shell">
            <div class="logo">
                <p>D</p>
            </div>
            <div class="journal-section journal-section-main">
                <header class="journal-header">
                    <div>
                        <h1 style="color: @ThemeService.AccentColor;">@JournalHeading</h1>
                    </div>
                    @*
                <div class="journal-toolbar">
                    <button class="journal-action primary" type="button" @onclick="CreateNewNotebookAsync">
                        + New journal
                    </button>

                    <select class="theme-select" value="@Theme" @onchange="HandleThemeChange"
                            style="background-color: @ThemeService.AccentColor !important; color: @ThemeService.TextColor
                !important;
            border: 2px solid @ThemeService.BorderColor;">
                        <option value="default">Default</option>
                        <option value="living">Living Room</option>
                        <option value="study">Study</option>
                        <option value="bedroom">Bedroom</option>
                    </select>
                </div> *@
                </header>

                @* <div class="journal-section-header">
                        <div>
                            <h2>@(notebook?.Title ?? "My Diary")</h2>
                        </div>
                    </div> *@

                <div class="journal-card">
                    <div class="journal-date-container">
                        <div class="page-indicator">Page @notebook?.CurrentPage / @notebook?.TotalPages</div>
                        <label for="date" class="visually-hidden">Page date</label>
                        <div class="journal-date-input-container">
                            <input @key="dateHighlightSequence" type="date"
                                   class="journal-date @(dateHighlightSequence > 0 ? "date-highlight" : "")" id="date"
                                   aria-label="Edit page date"
                                   value="@(currentNote?.Date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty)"
                                   @onchange="HandleDateChange" disabled="@(currentNote is null)">
                          
                        </div>
                    </div>
                    <div class="progress-bar" aria-label="Notebook progress">
                        <span style="width: @NotebookProgress%"></span>
                    </div>

                    <label for="note-box"></label>
                    <div class="journal-area @(isFirstPage ? "first-page-font" : "")" name="note" contenteditable="true"
                         role="textbox" aria-multiline="true" data-placeholder="Write Something Interesting"
                         @oninput="HandleEditorInput" @onkeydown="HandleNoteKeyDown" @ref="editorRef" id="note-box"></div>

                    <div class="text-options">
                        <div class="italic" role="button" tabindex="0" aria-label="Italic"
                             @onmousedown:preventDefault="true" @onclick="ApplyItalic">
                            <p>I</p>
                        </div>
                        <div class="bold" role="button" tabindex="0" aria-label="Bold" @onmousedown:preventDefault="true"
                             @onclick="ApplyBold">
                            <p>B</p>
                        </div>
                        <div class="underline" role="button" tabindex="0" aria-label="Underline"
                             @onmousedown:preventDefault="true" @onclick="ApplyUnderline">
                            <p>U</p>
                        </div>
                        <div class="title" role="button" tabindex="0" aria-label="Title"
                             @onmousedown:preventDefault="true" @onclick="ApplyTitle">
                            <p>T</p>
                        </div>
                    </div>
                </div>

                <div class="page-actions">
                    <button class="journal-action primary submit-button" href="/journals"
                            @onclick="NavigateToJournals">Journals</button>
                    <button @onclick="HandlePreviousPageClick" @ref="previousPageButton" class="journal-action secondary"
                            type="button" disabled="@isNavigatingPage">Previous</button>
                    <button @onclick="HandleNextPageClick" @ref="nextPageButton" class="journal-action secondary"
                            type="button" disabled="@isNavigatingPage">Next</button>
                    <button @onclick="HandleManualSave"
                            class="journal-action primary submit-button @(isSaved && hasManualSave ? "saved" : "")"
                            type="button" disabled="@isSaving">
                        @(isSaving && hasManualSave ? "Saving..." : isSaved && hasManualSave ? "Saved!" : "Save Note")
                    </button>
                </div>
            </div>

            @* <aside class="journal-section journal-section-side">
                    <div class="journal-section-header compact">
                        <div>
                            <span class="card-label">Recent entries</span>
                            <h3>Notebook overview</h3>
                        </div>
                    </div>

                    <div class="notes-saved">
                        @if (savedNotes != null && savedNotes.Count > 0)
                        {
                            @foreach (var savedNote in savedNotes)
                            {
                                <div class="note-saved">
                                    <p>@(string.IsNullOrWhiteSpace(savedNote.Text) ? "Empty page" : savedNote.Text)</p>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="note-saved empty-state">
                                <p>No saved pages yet.</p>
                            </div>
                        }
                    </div>
                </aside> *@
           
        </div>
    </div>
}

@code {

    [Parameter]
    public int? JournalId { get; set; }

    private ElementReference editorRef;
    private ElementReference previousPageButton;
    private ElementReference nextPageButton;
    private string JournalHeading => JournalId.HasValue
        ? notebook?.Title ?? "Journal"
        : string.IsNullOrWhiteSpace(DisplayName) ? "Hello" : $"Hello, {DisplayName}";
    private bool isFirstPage => notebook?.CurrentPage == 1;
    private string DisplayName { get; set; } = string.Empty;
    private double NotebookProgress => notebook is null || notebook.TotalPages <= 0
        ? 0
        : Math.Min(100, (notebook.CurrentPage / (double)notebook.TotalPages) * 100);

    public string Theme => ThemeService.Theme;
    public string textValue = "";
    Notebook? notebook;
    Note? currentNote;
    List<Note> savedNotes = new();
    private bool isSaving;
    private bool isSaved;
    private bool hasManualSave;
    private string? currentUserEmail;
    private bool hasLoadedAnonymousBrowserStorage;
    private bool editorContentNeedsSync = true;
    private bool hasLoadedRoute;
    private int? loadedJournalId;
    private bool isNavigatingPage;
    private int dateHighlightSequence;

    private async Task ApplyItalic()
    {
        await ApplyFormattingAsync("italic");
    }

    private async Task ApplyBold()
    {
        await ApplyFormattingAsync("bold");
    }

    private async Task ApplyUnderline()
    {
        await ApplyFormattingAsync("underline");
    }

    private async Task ApplyTitle()
    {
        await ApplyFormattingAsync("title");
    }

    private async Task ApplyFormattingAsync(string format)
    {
        var result = await JS.InvokeAsync<string?>(
            "formatContentEditableSelection", editorRef, format);

        if (result == null)
        {
            return;
        }

        textValue = result;
        await SaveNote();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleEditorInput()
    {
        textValue = await JS.InvokeAsync<string>("getContentEditableHtml", editorRef);
        await SaveOnTyping();
    }

    private async Task HandleThemeChange(ChangeEventArgs e)
    {
        if (e.Value is string newTheme)
        {
            await ThemeService.SetTheme(newTheme);
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        ThemeService.OnThemeChanged += OnThemeChangedHandler;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (hasLoadedRoute && loadedJournalId != JournalId && notebook is not null)
        {
            await SaveNote();
        }

        await LoadNotebookForCurrentUserAsync();
        loadedJournalId = JournalId;
        hasLoadedRoute = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                hasLoadedAnonymousBrowserStorage = true;
            }
            else
            {
                hasLoadedAnonymousBrowserStorage = true;
                if (!JournalId.HasValue)
                {
                    var storedNotebook = await StorageService.LoadNotebookAsync();
                    if (storedNotebook != null)
                    {
                        notebook = storedNotebook;
                        savedNotes = notebook.Notes.ToList();
                        SetCurrentNote();
                        await StorageService.SaveNotebookAsync(notebook);
                        await InvokeAsync(StateHasChanged);
                    }
                    else if (notebook != null)
                    {
                        await StorageService.SaveNotebookAsync(notebook);
                    }

                    if (storedNotebook is null && isFirstPage)
                    {
                        textValue = "My Diary";
                    }
                }
                else
                {
                    notebook = null;
                    currentNote = null;
                    textValue = string.Empty;
                }
            }
        }

        await SyncEditorContentAsync();
    }

    private async Task SyncEditorContentAsync()
    {
        if (!editorContentNeedsSync)
        {
            return;
        }

        editorContentNeedsSync = false;
        await JS.InvokeVoidAsync("setContentEditableHtml", editorRef, textValue ?? string.Empty);
    }

    private async void HandleAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var authState = await task;
            hasLoadedAnonymousBrowserStorage = authState.User.Identity?.IsAuthenticated == true;
            await LoadNotebookForCurrentUserAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                await StorageService.ClearAnonymousStorageAsync();
            }
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadNotebookForCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            if (JournalId.HasValue)
            {
                ClearNotebookState();
                return;
            }

            // Browser storage is loaded after interactive rendering in OnAfterRenderAsync.
            notebook = CreateNewNotebook(isAnonymous: true);
            DisplayName = string.Empty;
            currentUserEmail = null;
            savedNotes = notebook.Notes.ToList();
            SetCurrentNote();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var email = user.FindFirstValue(ClaimTypes.Email) ?? user.Identity.Name ?? user.FindFirstValue("email") ?? string.Empty;
        currentUserEmail = email;

        if (!string.IsNullOrWhiteSpace(DisplayName) && DisplayName.Contains('@'))
        {
            DisplayName = DisplayName.Split('@')[0];
        }

        if (!string.IsNullOrWhiteSpace(email) && email.Contains('@'))
        {
            DisplayName = email.Split('@')[0];
        }

        notebook = await StorageService.LoadNotebookAsync(JournalId);

        if (notebook is null && JournalId.HasValue)
        {
            ClearNotebookState();
            return;
        }

        if (notebook == null)
        {
            var userAccount = await DbContext.UserAccounts
                .SingleOrDefaultAsync(u => u.Email.ToLower() == email.ToLower());

            if (userAccount == null)
            {
                ClearNotebookState();
                return;
            }

            notebook = new Notebook
            {
                Title = "My Diary",
                Date = DateTime.Today,
                CurrentPage = 1,
                TotalPages = 20,
                UserAccountId = userAccount.Id,
                UserAccount = userAccount
            };

            notebook.Notes = new List<Note>();
            for (int i = 0; i < notebook.TotalPages; i++)
            {
                notebook.Notes.Add(new Note
                {
                    Date = i == 0 ? DateTime.Today : null,
                    Text = string.Empty,
                    Notebook = notebook
                });
            }

            notebook.Notes[0].Text = "Journal";
            DbContext.Notebooks.Add(notebook);
            await DbContext.SaveChangesAsync();
        }

        savedNotes = notebook.Notes.ToList();
        SetCurrentNote();
        await StorageService.SaveNotebookAsync(notebook);
        await InvokeAsync(StateHasChanged);
    }

    private void ClearNotebookState()
    {
        notebook = null;
        currentNote = null;
        textValue = string.Empty;
        editorContentNeedsSync = true;
        savedNotes = new List<Note>();
        currentUserEmail = null;
        DisplayName = string.Empty;
    }

    private async Task NavigateToJournals()
    {
        await SaveNote();
        NavManager.NavigateTo("/journals", forceLoad: false);
    }

    private void SetCurrentNote()
    {
        if (notebook == null)
        {
            currentNote = null;
            textValue = string.Empty;
            editorContentNeedsSync = true;
            return;
        }

        notebook.TotalPages = Math.Max(1, notebook.TotalPages);
        notebook.CurrentPage = Math.Clamp(notebook.CurrentPage, 1, notebook.TotalPages);
        var orderedNotes = notebook.Notes
            .OrderBy(note => note.Id == 0 ? int.MaxValue : note.Id)
            .ToList();
        while (orderedNotes.Count < notebook.CurrentPage)
        {
            var note = new Note
            {
                Date = orderedNotes.Count == 0 ? DateTime.Today : null,
                NotebookId = notebook.Id,
                Notebook = notebook
            };
            notebook.Notes.Add(note);
            orderedNotes.Add(note);
        }

        currentNote = orderedNotes[notebook.CurrentPage - 1];
        if (notebook.CurrentPage == 1 && currentNote.Date is null)
        {
            currentNote.Date = DateTime.Today;
        }
        textValue = currentNote?.Text ?? "";
        editorContentNeedsSync = true;
    }

    public async Task NextPage()
    {
        if (notebook == null || isNavigatingPage)
        {
            return;
        }

        if (notebook.CurrentPage >= notebook.TotalPages)
        {
            return;
        }

        isNavigatingPage = true;
        try
        {
            hasManualSave = true;
            await SaveNote();

            var orderedNotes = notebook.Notes
                .OrderBy(note => note.Id == 0 ? int.MaxValue : note.Id)
                .ToList();
            var targetPageNumber = notebook.CurrentPage + 1;
            var targetIndex = targetPageNumber - 1;
            var destinationNote = targetIndex < orderedNotes.Count
                ? orderedNotes[targetIndex]
                : new Note
                {
                    NotebookId = notebook.Id,
                    Notebook = notebook
                };
            if (!notebook.Notes.Contains(destinationNote))
            {
                notebook.Notes.Add(destinationNote);
            }

            notebook.CurrentPage = targetPageNumber;
            SetCurrentNote();
            dateHighlightSequence++;
            await StorageService.SaveNotebookAsync(notebook);
        }
        finally
        {
            isNavigatingPage = false;
        }
    }

    public async Task PreviousPage()
    {
        if (notebook == null || isNavigatingPage)
        {
            return;
        }

        if (notebook.CurrentPage <= 1)
        {
            return;
        }

        isNavigatingPage = true;
        try
        {
            hasManualSave = true;
            await SaveNote();
            notebook.CurrentPage--;
            SetCurrentNote();
            await StorageService.SaveNotebookAsync(notebook);
        }
        finally
        {
            isNavigatingPage = false;
        }
    }

    private async Task HandleDateChange(ChangeEventArgs args)
    {
        if (currentNote is null || notebook is null || args.Value is not string value)
        {
            return;
        }

        if (string.IsNullOrEmpty(value))
        {
            currentNote.Date = notebook.CurrentPage == 1 ? DateTime.Today : null;
            await StorageService.SaveNotebookAsync(notebook);
            return;
        }

        if (!DateTime.TryParseExact(
                value,
                "yyyy-MM-dd",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var selectedDate))
        {
            return;
        }

        if (currentNote.Date?.Date == selectedDate.Date)
        {
            return;
        }

        currentNote.Date = selectedDate.Date;
        await StorageService.SaveNotebookAsync(notebook);
    }

    private async Task HandlePreviousPageClick()
    {
        await JS.InvokeVoidAsync("animateJournalPageButton", previousPageButton);
        await PreviousPage();
    }

    private async Task HandleNextPageClick()
    {
        await JS.InvokeVoidAsync("animateJournalPageButton", nextPageButton);
        await NextPage();
    }

    private Notebook CreateNewNotebook(bool isAnonymous = false)
    {
        var newNotebook = new Notebook
        {
            Title = $"Journal {DateTime.Today:MMM dd}",
            Date = DateTime.Today,
            CurrentPage = 1,
            TotalPages = 20
        };

        newNotebook.Notes = new List<Note>();
        for (int i = 0; i < newNotebook.TotalPages; i++)
        {
            newNotebook.Notes.Add(new Note
            {
                Date = i == 0 ? DateTime.Today : null,
                Text = string.Empty,
                Notebook = newNotebook
            });
        }

        if (!isAnonymous)
        {
            newNotebook.Notes[0].Text = "Journal";
        }

        return newNotebook;
    }

    private async Task CreateNewNotebookAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            // Authenticated: save to database
            var newNotebook = CreateNewNotebook(isAnonymous: false);
            var email = authState.User.FindFirstValue(ClaimTypes.Email) ?? authState.User.Identity?.Name ?? string.Empty;
            var userAccount = await DbContext.UserAccounts
                .SingleOrDefaultAsync(u => u.Email.ToLower() == email.ToLower());

            if (userAccount != null)
            {
                newNotebook.UserAccountId = userAccount.Id;
                newNotebook.UserAccount = userAccount;
                DbContext.Notebooks.Add(newNotebook);
                await DbContext.SaveChangesAsync();

                notebook = newNotebook;
                savedNotes = notebook.Notes.ToList();
                SetCurrentNote();
            }
        }
        else
        {
            // Anonymous: save to localStorage
            var newNotebook = CreateNewNotebook(isAnonymous: true);
            await StorageService.SaveNotebookAsync(newNotebook);

            notebook = newNotebook;
            savedNotes = notebook.Notes.ToList();
            SetCurrentNote();
        }
    }

    public async Task HandleManualSave()
    {
        hasManualSave = true;
        await SaveNote();
    }

    public async Task SaveNote()
    {
        if (currentNote == null || notebook == null)
        {
            return;
        }

        var newText = textValue ?? string.Empty;

        if (string.Equals(currentNote.Text, newText, StringComparison.Ordinal))
        {
            if (notebook.CurrentPage < 1)
            {
                notebook.CurrentPage = 1;
            }
            return;
        }

        isSaving = true;
        isSaved = false;
        StateHasChanged();

        try
        {
            await StorageService.SaveNoteAsync(notebook, currentNote, newText);

            if (hasManualSave)
            {
                isSaved = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            isSaving = false;
            if (hasManualSave)
            {
                _ = TriggerSavedResetAsync();
            }
        }
    }

    private async Task SaveOnTyping()
    {
        hasManualSave = false;
        await SaveNote();
    }

    private async Task TriggerSavedResetAsync()
    {
        await Task.Delay(1200);
        isSaved = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChangedHandler;
        AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }

    private async Task OnThemeChangedHandler()
    {
        StateHasChanged();
        await Task.CompletedTask;
    }

    async Task HandleNoteKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "ArrowRight")
        {
            await NextPage();
        }
        else if (e.CtrlKey && e.Key == "ArrowLeft")
        {
            await PreviousPage();
        }
    }
}